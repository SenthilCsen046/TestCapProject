{
  "name": "TestCapProject",
  "version": "1.0.0",
  "type": "commonjs",
  "dependencies": {
    "@cap-js/hana": "^3",
    "@sap/cds": "^10",
    "@sap/xssec": "^4"
  },
  "devDependencies": {
    "@cap-js/sqlite": "^3",
    "@sap/cds-dk": "^10",
    "cds-plugin-ui5": "^0.17.0",
    "rimraf": "^5.0.5",
    "mbt": "^1.2.49"
  },
  "scripts": {
    "start": "cds-serve",
    "watch-testcapproject": "cds watch --open testcapprojectnamespace.testcapproject/index.html?sap-ui-xx-viewCache=false --livereload false",
    "undeploy": "cf undeploy TestCapProject --delete-services --delete-service-keys --delete-service-brokers",
    "build": "rimraf resources mta_archives && mbt build --mtar archive",
    "deploy": "cf deploy mta_archives/archive.mtar --retries 1"
  },
  "private": true,
  "workspaces": [
    "app/*"
  ],
  "sapux": [
    "app/testcapproject"
  ],
  "cds": {
    "requires": {
      "[development]": {
        "auth": {
          "kind": "mocked",
          "users": {
            "john": {"password":"senthil",
              "roles": [
                "productmanager"
              ]
            },
            "senthil": {
                    "roles": [
                "productmanager"
              ]
            }
          }
        }
        , "db":{
            "mock": "sqlite",
            "credentials": {
              "database": "db.sqlite"
            }
        }
      }
    }
  }
}
